# <Project> — environment template.
# This file IS tracked. Every value here is blank or a harmless placeholder — a populated
# credential-shaped key in a tracked .env* file is a release-gate failure (tests/secrets.php runs first).
# Copy to .env (git-ignored) and fill per environment. Keys are grouped by the tier that needs them;
# delete the groups a project has decided not to build, and say so in platform-manifest.md.

# ---- Tier 0: application ----
APP_ENV=local                          # local | staging | production — drives IS_PRODUCTION, mail sink, mock billing
APP_NAME=<Project>
BASE_URL=https://<project>.localhost   # no path component; per environment
PHP_CLI_PATH=                          # local override when php is not on PATH; blank on the server

# ---- Tier 0: database (one key decides the route; an unstated host resolves to 127.0.0.1) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=<project>_dev                  # <project>_dev | <project>_staging | <project>
DB_USER=
DB_PASS=

# ---- Tier 0: operations ----
BACKUP_DIR=                            # OUTSIDE the document root; blank = backups disabled (deliberately)
BACKUP_KEEP=1                          # pre-migration dumps to keep
BACKUP_CRON_KEEP=28                    # scheduled dumps to keep
MYSQLDUMP_BIN=                         # pin when PATH is wrong (local Windows: the XAMPP exe)
MAIL_FROM=                             # ONE mailbox, validated; non-production never sends real mail
SESSION_LIFETIME=

# ---- Tier 1: identity ----
MFA_KEY=                               # encrypts stored TOTP secrets; belongs to the DATABASE — a restored or cloned database needs the key it was encrypted under; rotating or losing it locks every enrolled user out
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Tier 1: privacy ----
LEGAL_HOLD_KEY=                        # pseudonymisation key for legal-hold rows; per environment

# ---- Tier 2: machine API (server side) ----
SCHEMA_TOKEN=                          # per environment; never the same value on two environments

# ---- Tier 2: machine API (CLIENT side — the dev box's .env only; the names are contractual) ----
<PROJECT>_STAGING_API_TOKEN=           # the durable staging broker credential
<PROJECT>_BEARER=                      # the production read credential

# ---- Tier 2: support ----
SUPPORT_GUEST_SECRET=                  # signs guest ticket links
ATTACHMENTS_DIR=                       # OUTSIDE the document root; blank = attachments disabled
UPLOADS_DIR=

# ---- Tier 3: billing (sandbox on local + staging; live keys ONLY in production's secret file) ----
PAYMENT_PROVIDER=paddle
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=

# ---- Tier 3: support mailbox (read live, store nothing) — FALLBACK values only: the primary configuration
#      is the admin panel, stored encrypted under the master key (SKILL.md §6.18); leave blank once configured there ----
SUPPORT_IMAP_HOST=
SUPPORT_IMAP_PORT=993
SUPPORT_IMAP_USER=
SUPPORT_IMAP_PASS=
SUPPORT_SMTP_HOST=
SUPPORT_SMTP_PORT=465
SUPPORT_SMTP_USER=
SUPPORT_SMTP_PASS=

# ---- Project-specific provider keys (AI, images, TTS …) go below, one group per provider ----
